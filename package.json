{
  "name": "claude-office",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @claude-office/server --filter @claude-office/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @claude-office/server start",
    "prod": "pnpm build && pnpm start",
    "publish:cli": "pnpm build && pnpm --filter @ngmthaq20/claude-office publish --access public",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "version:sync": "node scripts/version.js sync",
    "version:check": "node scripts/version.js check",
    "version:bump": "node scripts/version.js bump"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
